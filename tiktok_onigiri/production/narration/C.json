{
  "version": "C Vlog版(文字なし)",
  "voices": {
    "narr": {
      "edge": "ja-JP-KeitaNeural",
      "rate": "+5%",
      "pitch": "+0Hz",
      "note": "Vlogの独り言。くだけた調子"
    }
  },
  "lines": [
    {
      "id": "C01",
      "who": "narr",
      "text": "新卒で独り暮らし、半年。"
    },
    {
      "id": "C02",
      "who": "narr",
      "text": "弁当は、自分で作るって決めた。"
    },
    {
      "id": "C03",
      "who": "narr",
      "text": "味噌汁は、今日もふきこぼす。"
    },
    {
      "id": "C04",
      "who": "narr",
      "text": "具は、梅と、鮭と。"
    },
    {
      "id": "C05",
      "who": "narr",
      "text": "ソーセージ。"
    },
    {
      "id": "C06",
      "who": "narr",
      "text": "子供の頃、母さんのおにぎりは、いつもこの三つ。"
    },
    {
      "id": "C08",
      "who": "narr",
      "text": "高校のとき、恥ずかしいからやめろって言った。"
    },
    {
      "id": "C09",
      "who": "narr",
      "text": "昨日、居酒屋で同じおにぎりに出会って、ちょっと泣きそうになった。"
    },
    {
      "id": "C10",
      "who": "narr",
      "text": "だから今日は、ソーセージ。"
    },
    {
      "id": "C11",
      "who": "narr",
      "text": "ちょっと、いびつ。"
    },
    {
      "id": "C12",
      "who": "narr",
      "text": "母さんに送った。ソーセージのやつ、うまいなって。"
    },
    {
      "id": "C13",
      "who": "narr",
      "text": "いってきます。"
    },
    {
      "id": "C14",
      "who": "narr",
      "text": "今日は、間に合った。"
    },
    {
      "id": "C15",
      "who": "narr",
      "text": "オープンアップしよ。"
    }
  ]
}