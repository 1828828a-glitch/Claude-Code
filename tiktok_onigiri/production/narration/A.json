      "rate": "+0%",
      "pitch": "+0Hz",
      "note": "社会人1年目の息子。落ち着いた独白"
    },
    "teen": {
      "edge": "ja-JP-KeitaNeural",
      "rate": "+8%",
      "pitch": "+25Hz",
      "note": "高校生の息子。苛立った声"
    },
    "mom": {
      "edge": "ja-JP-NanamiNeural",
      "rate": "-5%",
      "pitch": "-10Hz",
      "note": "母。やわらかく。A12(通知の文面を母の声で)だけで使う。要件が男性ナレのみなら、A12を「母さんから、メッセージが来た。」に差し替える"
    }
  },
  "lines": [
    {
      "id": "A01",
      "who": "teen",
      "text": "母さん、おにぎりにソーセージ入れるのやめろよ。"
    },
    {
      "id": "A02",
      "who": "teen",
      "text": "恥ずかしいから。"
    },
    {
      "id": "A04",
      "who": "narr",
      "text": "昨日、居酒屋のおにぎりに、ソーセージが入っていた。"
    },
    {
      "id": "A05",
      "who": "narr",
      "text": "新卒で独り暮らしを始めて、半年。"
    },
    {
      "id": "A06",
      "who": "narr",
      "text": "子供の頃は、弁当があるのが当たり前だった。"
    },
    {
      "id": "A08",
      "who": "narr",
      "text": "俺は、感謝もせずに鞄に放り込んでた。"
    },
    {
      "id": "A09",
      "who": "narr",
      "text": "具はいつも、梅、鮭、ソーセージ。"
    },
    {
      "id": "A10",
      "who": "narr",
      "text": "ソーセージは珍しいって、高校で知った。"
    },
    {
      "id": "A11",
      "who": "narr",
      "text": "ちょっと、泣きそうになった。"
    },
    {
      "id": "A12",
      "who": "mom",
      "text": "元気にやってる？無理しないでね。"
    },
    {
      "id": "A15",
      "who": "narr",
      "text": "ソーセージのやつ、うまいな。それだけ送った。"
    },
    {
      "id": "A16",
      "who": "narr",
      "text": "オープンアップしよ。"
    }
  ]
}