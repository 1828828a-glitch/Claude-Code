  "test_command": "python3 -m pytest -q -x --no-header -p no:cacheprovider tests",
  "test_globs": ["*.py"],
  "test_timeout": 180,
  "rebuild_reminders": [
    {
      "paths": ["furiochi_lab/data/", "furiochi_lab/web/src/", "furiochi_lab/engine/ai_coach.py", "furiochi_lab/engine/rubric.py"],
