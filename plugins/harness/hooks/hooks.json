{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"${CLAUDE_PLUGIN_ROOT}/scripts/session_start.py\" ]; then python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/session_start.py\"; fi",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"${CLAUDE_PLUGIN_ROOT}/scripts/prompt_guard.py\" ]; then python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/prompt_guard.py\"; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|Grep|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.py\" ]; then python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.py\"; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"${CLAUDE_PLUGIN_ROOT}/scripts/post_edit_check.py\" ]; then python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/post_edit_check.py\"; fi",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"${CLAUDE_PLUGIN_ROOT}/scripts/stop_tests.py\" ]; then python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/stop_tests.py\"; fi",
            "timeout": 200
          }
        ]
      }
    ]
  }
}
