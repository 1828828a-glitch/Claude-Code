# Copy to .meeting-copilot.env and fill in your own values.
MEETING_COPILOT_CHATGPT_PROJECT_URL='https://chatgpt.com/g/g-p-PROJECT_ID/project'

# Optional. Meeting passcode used when the Zoom URL does not embed ?pwd=.
# MEETING_COPILOT_ZOOM_PASSCODE='123456'

# Optional. Participant name shown in the Zoom meeting (default: GPT-Live).
# MEETING_COPILOT_NAME='GPT-Live'

# Optional. Both ChatGPT and Zoom share this local automation endpoint.
# MEETING_COPILOT_CDP_PORT=9223
